# Copia este archivo y renómbralo a ".env.local" (mismo directorio).
# Rellena los dos valores con los datos de tu proyecto de Supabase.
# Los encontrarás en Supabase → Settings → API.
#
# IMPORTANTE: usa siempre la clave "anon public". NUNCA la clave
# "service_role" en este archivo ni en la aplicación web.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-CLAVE-ANON-PUBLICA
